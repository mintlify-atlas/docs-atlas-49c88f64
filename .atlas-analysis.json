  "keyFeatures": [
    "C/C++ SDK with GPIO, camera, audio, display, and text event APIs",
    "Embedded Linux on Rockchip RV1106B (ARM Cortex-A7)",
    "30° FOV 640×480 monocular display support (optional)",
    "1080P camera with zero-copy shared memory image transfer",
    "WiFi 802.11b/g/n, Bluetooth 5.3, USB 2.0 connectivity",
    "IPC-based multi-client architecture via Unix Domain Sockets",
    "Cross-compilation toolchain for ARM target (arm-rockchip831-linux-uclibcgnueabihf)",
    "Pre-built AI Core service for out-of-box AI conversation workflows",
    "3D-printable hardware frame design files (STEP/DXF)",
    "Use cases: medical, industrial, educational, and consumer AR"
  ],
  "publicApiSurface": [
    "ai_gpio_event_client_create() / connect() / subscribe() / unsubscribe() / destroy()",
    "ai_core_init() / capture() / free_data() / cleanup()",
    "ai_audio_init() / play() / stop() / record_start() / record_stop() / suspend_resources() / resume_resources() / cleanup()",
    "ai_display_init() / connect() / get_framebuffer() / commit_frame() / request_focus() / cleanup()",
    "ai_text_event_client_create() / start() / destroy()",
